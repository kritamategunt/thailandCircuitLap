# --- Supabase ---------------------------------------------------------------
# Public values (safe for the browser; the app itself only uses them for display/health).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Used by API routes + MCP server.
SUPABASE_SERVICE_ROLE_KEY=

# --- MCP --------------------------------------------------------------------
# Bearer token required by /api/mcp. Generate: openssl rand -hex 32
MCP_API_KEY=

# --- Optional ---------------------------------------------------------------
# Raster terrain DEM tiles (terrarium/mapbox encoding) for real 3D terrain.
# Leave empty -> 3D mode uses pitched camera only (graceful fallback).
NEXT_PUBLIC_TERRAIN_TILES_URL=
NEXT_PUBLIC_TERRAIN_ENCODING=terrarium
